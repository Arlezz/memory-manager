  "cards": [
    {
      "dot": "cyan",
      "title": "The problem it solves",
      "items": [
        "Claude Code keys memory by absolute filesystem path",
        "The same repository at a different path gets a different, empty memory directory",
        "Identity here is the normalized git remote, so memory follows the repository instead"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two layers, one directory",
      "items": [
        "Project memory is committed and travels with the code",
        "Personal memory lives in a private repo, pulled at session start and pushed at session end",
        "Both merge into the single directory Claude Code already reads"
      ]
    },
    {
      "dot": "rose",
      "title": "On the way back out",
      "items": [
        "A manifest records which layer every merged file came from",
        "Frontmatter type decides where an edit belongs",
        "Project memory lands in your work tree and is never committed for you"
      ]
    }
  ]
